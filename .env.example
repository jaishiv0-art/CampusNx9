# ==============================================================================
# CampusNx9 - Chilika Institute of Technology (CIT) Configuration
# ==============================================================================

# ---- 1. SUPABASE DATABASE CONFIGURATION ----
# Get these from your Supabase Dashboard -> Project Settings -> API & Database
# URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (for browser/client requests)
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Service Role Key (for backend privileged operations & sync)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection String (Optional, for direct SQL migration)
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# ---- 2. BACKEND & SOLVER CONFIGURATION ----
JWT_SECRET=cit-campusnx9-secure-jwt-token-change-in-prod
DB_PATH=./cit.db
DATASET_PATH=./data/cit_public.json
EXPORT_DIR=./exports
TEAM_NAME=CampusNx9 CIT
SOLVE_SECONDS=180          # CP-SAT OR-Tools time limit per solve
SOLVER_WORKERS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 3. OPTIONAL AI NLP PARSING LAYER ----
# (Deterministic fallback parser active: plain English & Hinglish works even without API key)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ---- 4. FRONTEND CONFIGURATION ----
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
