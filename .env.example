# ==============================================================================
#                      CAMPUSNX9 - ENVIRONMENT CONFIGURATION TEMPLATE
#              Chilika Institute of Technology (CIT) Operations Platform
# ==============================================================================
#
# HOW TO USE THIS FILE:
# 1. Copy this file to '.env': 
#      cp .env.example .env
# 2. Fill in your project credentials (e.g. Supabase keys).
# 3. No quotes are needed around values.
#
# ==============================================================================
# SECTION 1: SUPABASE CLOUD DATABASE CONFIGURATION
# ==============================================================================
# Connects CampusNx9 to your Supabase PostgreSQL cloud database.
# Find these in Supabase Dashboard: Project Settings -> API.

# [REQUIRED] Project URL for your Supabase cloud project
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Public Anonymous Key: Safe for browser/client use (Row-Level Security enforced)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [REQUIRED FOR BACKEND] Service Role Key: Secret key for server-side admin sync operations.
# NEVER share this key publicly or expose it in frontend client code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# [OPTIONAL] Direct PostgreSQL connection URI (Useful for direct Prisma/Alembic migrations)
DATABASE_URL=


# ==============================================================================
# SECTION 2: BACKEND SERVER & DATABASE STORAGE
# ==============================================================================

# [REQUIRED] Secret string used to sign and verify user authentication JWT tokens.
JWT_SECRET=cit-campusnx9-secure-jwt-token-change-in-prod

# [REQUIRED] Path to local SQLite database file.
DB_PATH=./cit.db

# [REQUIRED] Path to initial CIT institutional dataset JSON.
DATASET_PATH=./data/cit_public.json

# [REQUIRED] Directory where schedule JSON, CSV, and export reports are generated.
EXPORT_DIR=./exports

# [OPTIONAL] Display team / institution branding name
TEAM_NAME=CampusNx9 CIT


# ==============================================================================
# SECTION 3: OR-TOOLS CP-SAT TIMETABLE SOLVER ENGINE
# ==============================================================================
# Configures the Google OR-Tools constraint satisfaction engine for timetable generation.

# [OPTIONAL] Max solve time in seconds for timetable optimization (Default: 180 seconds / 3 minutes)
SOLVE_SECONDS=180

# [OPTIONAL] Number of CPU worker threads dedicated to parallel constraint solving (Default: 8)
SOLVER_WORKERS=8


# ==============================================================================
# SECTION 4: NETWORK & CORS ACCESS CONTROL
# ==============================================================================
# Comma-separated list of allowed frontend URLs permitted to call the backend API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app,http://localhost:3000


# ==============================================================================
# SECTION 5: AI NATURAL LANGUAGE PROCESSING (NLP) ASSISTANT (OPTIONAL)
# ==============================================================================
# Powers AI chat queries and automated natural-language disruption requests.
# Leave blank to use built-in keyword heuristic parsing without requiring an external API key.

# [OPTIONAL] Anthropic API Key (e.g. sk-ant-api03-...)
ANTHROPIC_API_KEY=

# [OPTIONAL] LLM Model identifier
LLM_MODEL=claude-sonnet-4-6


# ==============================================================================
# SECTION 6: FRONTEND CLIENT CONFIGURATION (Vite React UI)
# ==============================================================================
# Variables with the 'VITE_' prefix are automatically bundled into the React frontend.

# [OPTIONAL] Backend API URL:
# - Leave empty (recommended) to use same-origin /api routing (handled automatically in production & via Vite proxy locally).
# - If running frontend against a separate external remote server, provide its base URL here.
VITE_API_URL=

# [REQUIRED] Supabase URL for direct frontend client queries
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Supabase Anon Key for direct frontend client queries
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
